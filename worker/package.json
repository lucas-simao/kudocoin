{
  "name": "kudocoin-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port ${KUDOCOIN_WORKER_PORT:-18611}",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "cd ../firebase && npx firebase emulators:exec --project demo-kudocoin --only auth,firestore 'bash ../worker/scripts/e2e.sh'"
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.35.0"
  }
}
