# The Firebase web app's settings (Project settings > Your apps). They are public by design;
# the Firestore rules and the Worker are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kudocoin.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kudocoin
VITE_FIREBASE_APP_ID=
# The Worker's address.
VITE_API_URL=https://kudocoin-api.<account>.workers.dev
# make dev sets these to use the emulators instead.
VITE_USE_EMULATORS=
